#!/bin/sh /etc/rc.common
#
# ledschedule — 夜间定时关闭面板/网口指示灯（procd 托管）
#
# START=97：在 led(96) 之后启动，保证能覆盖 led 服务刚应用的默认状态。
#
# 配置/状态生效走 procd 触发器，不靠重启：
#   uci commit ledschedule   → procd 触发 reload
#   ledctl off|on|auto|blink → 改完 /var/run/ledschedule.state 后显式 reload
#   NTP 校时（/etc/hotplug.d/ntp/30-ledschedule）→ reload
#   三条都落到 procd_send_signal（实例的 reload_signal=HUP）→ ledctl daemon
#   收 SIGHUP 原地重读配置与状态，并重算下一次唤醒时刻。
START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ledctl daemon
	# reload = 给实例发 SIGHUP，由 ledctl 自己重读配置与手动覆盖状态（见文件头）
	procd_set_param reload_signal HUP
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# uci 变更 / 手动切灯 / NTP 校时 → 只发信号，不重启进程。
	# 走 reload 而不是 restart 是有意的：restart 会经过 stop_service，夜里会闪一下
	# （熄灯→亮一下→再熄灯），且会清掉手动覆盖状态。见 docs/RFC-002 §3.1。
	procd_send_signal ledschedule
}

service_triggers() {
	procd_add_reload_trigger ledschedule
}

stop_service() {
	# 真正停服务/禁用时把灯按时段交还（会清掉手动覆盖），不要让用户以为灯坏了。
	# reload 不会走到这里，所以不会出现上面说的闪烁。
	# 用 restore 而不是 auto：auto 会再回头 reload 一次守护进程，没有意义。
	[ -x /usr/bin/ledctl ] && /usr/bin/ledctl restore >/dev/null 2>&1
	logger -t ledschedule "已停止，指示灯按 open 状态恢复"
}
